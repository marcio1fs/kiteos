// =============================================
// TOKEN SECURITY
// =============================================

model RefreshToken {
  id          String    @id @default(cuid())
  token       String    @unique
  userId      String
  officeId    String
  role        String
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  reason      String?   // 'ROTATION', 'TOKEN_THEFT_DETECTED', 'LOGOUT', 'PASSWORD_CHANGE', 'ACCOUNT_DEACTIVATED'
  createdAt   DateTime  @default(now())
  isRevoked   Boolean   @default(false)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  office      Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model TokenBlacklist {
  id          String    @id @default(cuid())
  jti         String    @unique
  userId      String
  officeId    String
  reason      String?   // 'LOGOUT', 'PASSWORD_CHANGE', 'ACCOUNT_DEACTIVATED', 'SECURITY'
  expiresAt   DateTime  // When the original JWT expires (auto-cleanup)
  createdAt   DateTime  @default(now())

  @@index([jti])
  @@index([expiresAt])
}
