  periodo         String   // AAAAMM
  bloco           String
  registro        String
  linha           String
  ordem           Int      @default(0)
  officeId        String
  office          Office   @relation(fields: [officeId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([officeId, periodo])
  @@index([bloco])
  @@index([registro]) // FIX: for querying specific record types
