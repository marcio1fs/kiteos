# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Empty database Prisma uses to compute migration diffs (required by
# `prisma migrate dev` and by the CI drift gate). docker-compose creates it.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/mydb_shadow?schema=public"

# Authentication secrets
# Run 'openssl rand -hex 32' to generate a secure random value
JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Certificate encryption key
CERT_ENCRYPTION_KEY="your-encryption-key-here"

# Platform operators (comma-separated user IDs). Tenant OWNER/ADMIN is NOT a
# platform role. Only these users can access /api/admin/*.
PLATFORM_ADMIN_USER_IDS=""

# Mercado Pago platform webhook secret (required when MP_PLATFORM_ACCESS_TOKEN is set)
MP_PLATFORM_WEBHOOK_SECRET=""

# Optional PEM bundle with ICP-Brasil roots not present in the Node trust store.
# Server certificate verification is always enabled for SEFAZ mTLS.
# SEFAZ_EXTRA_CA_CERTS="/etc/kiteos/icp-brasil.pem"

# --- Optional Configurations ---

# Redis (optional - for distributed rate limiting in multi-instance deployments)
# REDIS_URL="redis://localhost:6379"

# Mercado Pago credentials (optional)
MERCADO_PAGO_ACCESS_TOKEN="your-mp-access-token"
MERCADO_PAGO_PUBLIC_KEY="your-mp-public-key"

# WhatsApp API credentials (optional)
WHATSAPP_API_URL="https://api.whatsapp.com/v1"
WHATSAPP_API_TOKEN="your-whatsapp-token"
