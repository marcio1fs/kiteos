# =============================================================================
# KiteOS — variáveis de ambiente
#
# Esta lista é exatamente o que `src/lib/env.ts` lê e valida. Ela é conferida na
# partida por `src/instrumentation.ts`: em produção, variável obrigatória ausente
# (ou com valor de exemplo) impede o servidor de subir, e o log aponta o nome dela.
# `GET /api/ready` expõe o mesmo diagnóstico sem revelar valores.
#
# O que NÃO está aqui e nunca esteve: NextAuth (não é usado — a sessão é JWT
# próprio via JWT_SECRET), e credenciais de Mercado Pago e WhatsApp **por oficina**,
# que ficam no banco (colunas mpAccessToken/mpWebhookSecret e waApiUrl/waApiToken/
# waInstance, editáveis na tela de configurações). Definir MERCADO_PAGO_ACCESS_TOKEN
# ou WHATSAPP_API_TOKEN no ambiente não tem efeito nenhum.
# =============================================================================

# --- Banco -------------------------------------------------------------------
# Obrigatório. PostgreSQL (SQLite não é mais suportado).
DATABASE_URL="postgresql://kiteos:kiteos@localhost:5432/kiteos?schema=public"

# Banco vazio que o Prisma usa para calcular diffs de migration (necessário para
# `prisma migrate dev` e para o gate de drift do CI). O docker-compose o cria.
# Não é lido pela aplicação em runtime.
SHADOW_DATABASE_URL="postgresql://kiteos:kiteos@localhost:5432/kiteos_shadow?schema=public"

# --- Segredos ----------------------------------------------------------------
# Obrigatórios, mínimo de 32 caracteres, e não podem ser valores de exemplo.
# Gere com: openssl rand -hex 32
#
# JWT_SECRET assina os tokens de sessão.
JWT_SECRET=""

# CERT_ENCRYPTION_KEY protege em repouso o certificado A1 (senha do .pfx) e os
# tokens por oficina (Mercado Pago, WhatsApp). Sem ela, gravar esses segredos
# falha — o sistema não os grava em texto puro.
CERT_ENCRYPTION_KEY=""

# --- URL pública -------------------------------------------------------------
# Obrigatória em produção; precisa ser absoluta, https:// e alcançável de fora
# (nada de localhost, 127.0.0.1 ou host .internal). É a base dos back_urls e do
# notification_url enviados ao Mercado Pago, dos redirects de retorno do checkout
# e dos links enviados ao cliente. Em desenvolvimento, se ausente, assume
# http://localhost:3000.
NEXT_PUBLIC_APP_URL="https://app.sua-oficina.com.br"

# --- Operação da plataforma (SaaS) -------------------------------------------
# Operadores de plataforma, separados por vírgula. É o id do usuário (users.id),
# não o e-mail. Papel de tenant (OWNER/ADMIN) NUNCA dá acesso a /api/admin/*:
# sem esta variável, essas rotas recusam todo mundo com 403.
PLATFORM_ADMIN_USER_IDS=""

# Mercado Pago da plataforma (cobrança das assinaturas do KiteOS). Opcional: sem
# ele, cada oficina usa a própria conta MP configurada na tela de configurações.
# Valores com "xxxxxxxx" ou "your-...-here" são reconhecidos como placeholder e
# ignorados (com aviso no log de partida).
MP_PLATFORM_ACCESS_TOKEN=""

# Obrigatório quando MP_PLATFORM_ACCESS_TOKEN está configurado: sem ele os
# webhooks de assinatura não têm como ter a assinatura validada, e a rota responde
# 503 em vez de processar pagamento.
MP_PLATFORM_WEBHOOK_SECRET=""

# --- Opcionais ---------------------------------------------------------------
# Redis para rate limiting distribuído em deployments com mais de uma instância.
# Sem ele o rate limit é em memória (por processo). Aceita redis:// ou rediss://.
# REDIS_URL="redis://localhost:6379"

# Bundle PEM com raízes ICP-Brasil ausentes do trust store do Node. A validação do
# certificado do servidor SEFAZ está sempre ativa no mTLS. O arquivo precisa
# existir: a partida falha se o caminho estiver errado.
# SEFAZ_EXTRA_CA_CERTS="/etc/kiteos/icp-brasil.pem"

# Ambiente: development, test ou production. Ausente ou com outro valor
# ("staging", "homolog") é tratado como production — as proteções não dependem de
# NODE_ENV ter um valor exato para estarem ligadas.
# NODE_ENV="production"

# SOMENTE desenvolvimento/teste: permite gravar token de oficina em texto puro
# quando CERT_ENCRYPTION_KEY não está definido. Em produção é recusado na partida.
# Existe para quem está subindo o projeto pela primeira vez sem segredo configurado.
# ALLOW_INSECURE_PLAINTEXT_TOKENS="true"
